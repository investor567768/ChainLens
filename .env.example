# Copy to .env (or set these in your host's dashboard). All are optional.
PORT=3000
HOST=127.0.0.1

# Paid Deep Investigations through Buy (Chainstack, x402)
BUY_ACCOUNT=agent
PAID_ENABLED=1
MAX_PAID_PER_DAY=10
# BUY_ROUTE=
# BUY_TOKEN=
# BUY_MAX_AMOUNT=
# BUY_CMD=
# BUY_TIMEOUT_MS=

# Hosting only: where Buy keeps its key on a server (no OS keychain there)
# BUY_KEYSTORE_BACKEND=file
# BUY_HOME=/data/buy
# One-time import of an existing key. Keep it in the host's secret variables, never in git. Delete it after the first start.
# BUY_IMPORT_KEY=

# Data sources
# CELO_RPC=
# BLOCKSCOUT_BASE=
# SQD_BASE=

# Where the payment ledger and activity log are stored
# CHAINLENS_DATA_DIR=./data

# Leave your own test wallets out of the "users who ordered" count
# CHAINLENS_IGNORE_ORDERERS=
# CHAINLENS_IGNORE_SIDS=
